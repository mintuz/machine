# CLI tools shared by macOS, Ubuntu, and both profiles.

# Version control
brew "git"
brew "worktrunk"
brew "gh"
brew "lazygit"

# Core shell utilities
brew "curl"
brew "wget"
brew "tree"
brew "stow"
brew "zellij"
brew "fzf"
brew "z"
brew "starship"
brew "thefuck"
brew "eza"
brew "bat"
brew "tlrc"

# Search, data, and network tools
brew "ripgrep"
brew "fd"
brew "jq"
brew "httpie"
brew "yt-dlp"
brew "aria2"

# Language runtimes and package managers
brew "yarn"
brew "pnpm"
brew "nvm"
brew "pipx"
brew "deno"
brew "go"

# Setup automation
brew "ansible"

# Databases and infrastructure
brew "mysql-client"
brew "pscale"

# Build systems and Swift tooling
brew "cmake"
brew "asciinema"
brew "xcbeautify"
brew "swiftformat"
brew "swift-format"

# System monitoring
brew "glances"

# AI and app CLIs
cask "codex"
brew "opencode"
cask "notion-cli"
cask "1password-cli"
cask "claude-code@latest", greedy: true
