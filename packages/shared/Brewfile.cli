# CLI formulae shared by macOS, Ubuntu and both profiles. Failures stop setup.
#
# Plain Homebrew Bundle syntax. `mise bootstrap` runs `brew bundle install`
# once per layer file from the hooks in mise.toml, mise.macos.toml and
# mise.<profile>.toml. Casks are macOS-only; keep them in packages/mac/ and
# declare a Linux provider in mise/conf.d/tools.toml with os = ["linux"].
# A third-party formula needs its `tap` line and `trusted: true` on the item;
# never trust a whole tap.

# Version control
brew "git"
brew "worktrunk"
brew "gh"
brew "lazygit"

# Core shell utilities
brew "curl"
brew "wget"
brew "tree"
brew "stow"
brew "zellij"
brew "fzf"
brew "z"
brew "starship"
brew "thefuck"
brew "eza"
brew "bat"
brew "tlrc"

# Search, data, and network tools
brew "ripgrep"
brew "fd"
brew "jq"
brew "httpie"
brew "yt-dlp"
brew "aria2"

# Python application installer
brew "pipx"

# Databases and infrastructure
brew "mysql-client"
brew "pscale"

# Build systems and Swift tooling
brew "cmake"
brew "asciinema"
brew "xcbeautify"
brew "swiftformat"
brew "swift-format"

# System monitoring
brew "glances"

# AI and app CLIs
brew "opencode"
tap "can1357/tap"
brew "can1357/tap/omp", trusted: true
